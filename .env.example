# Server-side only. NEVER expose these to the client.
# AI_PROVIDER: "mock" (default, deterministic, no external calls) or "gemini" (D6).
# GeminiProvider is used only when AI_PROVIDER=gemini AND GEMINI_API_KEY is set;
# otherwise the server falls back to the mock provider.
AI_PROVIDER=mock
GEMINI_API_KEY=
# D8 monetization: HMAC secret for Pro license keys (scripts/generate-license.mjs).
# When unset, every license key is treated as invalid (free tier only).
LICENSE_SECRET=

# D8 monetization: Stripe Payment Link shown in the client upgrade CTA (public URL, not a secret).
VITE_UPGRADE_URL=
